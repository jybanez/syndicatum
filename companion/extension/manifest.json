{
  "manifest_version": 3,
  "name": "Syndicatum Companion",
  "version": "0.1.0",
  "description": "Routes Syndicatum notifications into the correct existing AI discussion.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://chatviewer.pbb.ph/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Syndicatum Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["providers/chatgpt.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
