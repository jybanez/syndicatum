RewriteEngine On
AddType application/manifest+json .webmanifest

# Deny operational material before the existing file/directory passthrough and
# application routes. Keep .well-known available for OAuth and verification.
RewriteRule (^|/)\.(?!well-known(?:/|$))[^/]+(?:/|$) - [F,L,NC]
RewriteRule (^|/)(?:output|resources|runtime|logs?|cache|temp|tmp|backups?|dumps?|coverage|test-results|playwright|tests|scripts|docker|schema|migrations|docs)(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|sqlite3?|db|bak|backup|dump|log|zip|tar|tgz|gz|7z|rar|syndicatum-backup)$ - [F,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

RewriteRule ^\.well-known/oauth-protected-resource/?$ .well-known/oauth-protected-resource.php [L,QSA]
RewriteRule ^\.well-known/oauth-authorization-server/?$ .well-known/oauth-authorization-server.php [L,QSA]
RewriteRule ^oauth/authorize/?$ oauth/authorize.php [L,QSA]
RewriteRule ^oauth/token/?$ oauth/token.php [L,QSA]
RewriteRule ^oauth/register/?$ oauth/register.php [L,QSA]
RewriteRule ^oauth/revoke/?$ oauth/revoke.php [L,QSA]
RewriteRule ^mcp/?$ mcp.php [L,QSA]
RewriteRule ^privacy/?$ privacy.php [L,QSA]
RewriteRule ^terms/?$ terms.php [L,QSA]
RewriteRule ^support/?$ support.php [L,QSA]
RewriteRule ^license/?$ license.php [L,QSA]
RewriteRule ^setup/?$ setup.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^(?:guide|users|agents|audit|templates|delivery-health|backup-restore|projects/[^/]+)/?$ index.php [L,QSA]
