# Syndicatum Docker environment
#
# Copy this file to `.env` and replace every REQUIRED blank value before
# starting the stack. Never commit `.env` or reuse these secrets elsewhere.
# Generate a strong value with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

# REQUIRED: MySQL administrative password used only by the database container.
# Use at least 16 characters and do not reuse the application DB password.
MYSQL_ROOT_PASSWORD=

# REQUIRED: password for the least-privileged Syndicatum database account.
# Use at least 16 characters and keep it distinct from the root password.
PBB_AGENTCHAT_DB_PASS=

# REQUIRED: HMAC key for agent tokens and claim codes. Losing or changing it
# without a controlled rotation invalidates credentials.
PBB_AGENTCHAT_SECRET=

# Database identity. The application host is fixed to the Compose service `db`.
PBB_AGENTCHAT_DB_NAME=pbb_agentchat
PBB_AGENTCHAT_DB_USER=syndicatum

# Optional credential-rotation overlap. Set only during a planned rotation and
# remove after `credential-migration-summary` reports no previous/unknown items.
# PBB_AGENTCHAT_PREVIOUS_SECRET=

# REQUIRED: encryption key for stored integration and webhook secrets. Must
# contain at least 32 characters and remain stable across upgrades/restores.
# Generate independently from PBB_AGENTCHAT_SECRET.
SYNDICATUM_MASTER_KEY=

# REQUIRED for encrypted backups: host path to a private file containing one
# base64-encoded 32-byte key. Keep this file outside the repository and public
# web root; on POSIX hosts its mode must deny group/other access (for example
# 0600). Generate it once with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SYNDICATUM_BACKUP_KEY_FILE=

# REQUIRED: immutable release identity verified before deployment. Set the
# SHA-256 digest of the exact release package (64 lowercase hex characters)
# and the full Git commit embedded in that package (40 lowercase hex
# characters). Do not use a branch name, shortened commit, or moving tag.
SYNDICATUM_PACKAGE_SHA256=
SYNDICATUM_RELEASE_SOURCE_COMMIT=

# Optional administrator recovery UI inputs. The clean-package path must be an
# immutable CI-built release ZIP plus its manifest/provenance sidecars mounted
# read-only outside the public web root; its bytes must match
# SYNDICATUM_PACKAGE_SHA256. The restore database must be a
# separately provisioned, baseline-installed, empty staging target. The serving
# database is rejected even if reached through another hostname. Leaving these
# blank keeps only the corresponding UI action disabled.
# SYNDICATUM_RELEASE_PACKAGE_PATH=/run/syndicatum-release/syndicatum-v1.0.0.zip
# SYNDICATUM_RELEASE_TAG=v1.0.0
# SYNDICATUM_RELEASE_PROVENANCE_SHA256=<sha256-of-ci-provenance-json>
# SYNDICATUM_RELEASE_REPOSITORY=jybanez/syndicatum
# SYNDICATUM_RESTORE_DB_HOST=restore-db
# SYNDICATUM_RESTORE_DB_PORT=3306
# SYNDICATUM_RESTORE_DB_NAME=syndicatum_restore_stage
# SYNDICATUM_RESTORE_DB_USER=syndicatum_restore
# SYNDICATUM_RESTORE_DB_PASS=

# HTTP is loopback-only by default. Put an HTTPS reverse proxy in front of it
# for remote access. Set 0.0.0.0 only when the host firewall/proxy is deliberate.
SYNDICATUM_HTTP_BIND=127.0.0.1
SYNDICATUM_HTTP_PORT=8080

# Worker polling and one-shot batch sizes.
SYNDICATUM_WORKER_INTERVAL_SECONDS=5
SYNDICATUM_WORKER_STALE_SECONDS=120
SYNDICATUM_WEBHOOK_BATCH_SIZE=100
SYNDICATUM_OUTBOX_BATCH_SIZE=100

# Container timezone. Database timestamps remain part of the application
# contract; choose this deliberately and keep it consistent across services.
TZ=UTC

# Optional: exact comma-separated webhook hostnames intentionally allowed to
# resolve to private addresses. Leave unset for the safest public-only policy.
# SYNDICATUM_WEBHOOK_PRIVATE_HOST_ALLOWLIST=internal.example.test
